# Leave VITE_API_URL empty in development so that all /api/* requests
# use relative paths and are forwarded by the Vite proxy (see vite.config.js).
# This avoids CORS issues since the browser sees same-origin requests.
#
# In production, set this to your real API origin:
#   VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# The Gateway URL — used ONLY by the redirect page to send the browser
# to GET /{shortCode} which returns HTTP 302.
VITE_GATEWAY_URL=http://localhost:8080

# Public URL used for display, QR codes, and sharing.
# In production: https://yourdomain.com
VITE_PUBLIC_URL=http://localhost:3000
